# All variables are read from the process environment. A .env file (in the
# working directory or in config/) is loaded if present; it is optional and
# never overrides variables already set in the environment.

# DATABASE_URL specifies the connection string for the MongoDB database.
# Format: "mongodb://<host>:<port>"
# Default: "mongodb://localhost:27017"
DATABASE_URL=mongodb://localhost:27017

# DATABASE_NAME is the MongoDB database used to store messages.
# Default: "onetime"
DATABASE_NAME=onetime

# PORT is the HTTP port the API listens on.
# Default: 8080
PORT=8080
